    "users": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "blind",
          "low-vision",
          "color-vision-deficiency"
        ]
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "evidence"
      ],
      "properties": {
        "primary": {
          "enum": [
            "automatic",
            "agent-review",
            "rendered-review",
            "manual-at",
            "manual-human"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SOURCE",
              "RENDERED_DOM",
              "COMPUTED_STYLE",
              "RENDERED_GEOMETRY",
              "KEYBOARD_INTERACTION",
              "POINTER_INTERACTION",
              "VISUAL_INSPECTION",
              "ACCESSIBILITY_TREE",
              "SCREEN_READER",
              "CONTENT_JUDGMENT",
