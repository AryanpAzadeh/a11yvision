  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "conformance"
          }
        }
      },
      "then": {
        "properties": {
          "wcag": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "const": "AV-FRC-001"
          }
        }
      },
      "then": {
        "properties": {
          "scope": {
            "const": "advisory"
          },
          "severity_default": {
            "const": "advisory"
          },
          "wcag": {
            "maxItems": 0
          }
        }
      }
    }
